
#!name=虎扑开屏不白屏
#!desc=goblin 开屏广告 mock 空广告，避免 REJECT 干等
#来源于“广告必须死”tg群
#!arg=

[Rule]
DOMAIN-SUFFIX,goblin.hupu.com,DIRECT

[Rewrite]
response if ${url} ~= /^https?:\/\/goblin\.hupu\.com\/\d+\/[\d.]+\/interfaceAd\/getOther/ then response.body.mock("json", {"ad_code":-41,"show_type":0,"ads":[]}, 200)

[MITM]
hostname = goblin.hupu.com
